(version 1)
(allow default)

; Pass the host home with -D HOME="$HOME" before entering the isolated environment.
(define host-home (param "HOME"))
(define data-home (string-append "/System/Volumes/Data" host-home))

; H1 fixture. Run with an empty environment and an isolated HOME.
(deny file-write*)
(allow file-write*
    (subpath "/private/tmp/hermes-h1")
    (literal "/dev/null")
    (literal "/dev/tty")
    (subpath "/dev/fd"))

; The live Hermes home contains credentials and user configuration.
(deny file-read*
    (subpath (string-append host-home "/.hermes"))
    (subpath (string-append data-home "/.hermes")))

; Cover the rest of the real home, including other credentials and the checkout.
(deny file-read*
    (subpath host-home)
    (subpath data-home))

; Use -D HERMES_NETWORK=install only for installation and the GitHub control.
; Measurement uses -D HERMES_NETWORK=off. Other values also deny networking.
(if (not (equal? (param "HERMES_NETWORK") "install"))
    (deny network*))

{
  "assertions": [
    {
      "type": "output_contains_any",
      "values": [
        "returncode",
        "exit code",
        "exit status",
        "결과를 확인하지",
        "결과 미검증",
        "검증하지 않",
        "false green",
        "false-green",
        "성공을 가정",
        "확인 없이 성공",
        "무시하고",
        "실패해도"
      ]
    },
    {
      "type": "output_contains_any",
      "values": [
        "run_migration",
        "deploy.py"
      ]
    },
    {
      "type": "output_not_regex",
      "patterns": [
        "^[ \\t>#*_+\\-✅✔☑️]*(?:\\d+[.)][ \\t]+)?(?:(?:판정|결론|요약|종합|(?:전체|최종|보안|검토|리뷰|스캔) ?(?:상태|판정|결과)|verdict|conclusion|summary|overall|result|status)[ \\t*_]*[:：][ \\t*_✅✔☑️]*)?(?:(?:이 (?:코드|변경|파일)에는|전체적으로|종합적으로|결론적으로|(?:검토|분석) 결과,?|보안|주요|발견된|전체|전혀)[ \\t]+)*(?:취약점|버그)(?:이|은|가|는|을)?[ \\t]?(?:없음|없습니다|없다|발견되지 않(?:았습니다|았다|음)|발견하지 못(?:했습니다|했다|함))[ \\t.!*_`✅✔☑️]*$",
        "^[ \\t>#*_+\\-✅✔☑️]*(?:\\d+[.)][ \\t]+)?(?:(?:판정|결론|요약|종합|(?:전체|최종|보안|검토|리뷰|스캔) ?(?:상태|판정|결과)|verdict|conclusion|summary|overall|result|status)[ \\t*_]*[:：][ \\t*_✅✔☑️]*)?(?:no|zero)[ \\t]+(?:vulnerabilities|issues|bugs)(?:[ \\t]+(?:found|detected|identified))?[ \\t.!*_`✅✔☑️]*$"
      ]
    }
  ],
  "judge": {
    "enabled": false,
    "rubric": "리뷰가 subprocess.run의 returncode를 검증하지 않고 무조건 성공(True)을 반환/출력하는 false-green 패턴을 정확히 지적하는가?",
    "threshold": 7
  }
}

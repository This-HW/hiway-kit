#!/bin/bash
# kit-managed-hook
#   ↑ **드리프트 대조용 마커.** 계약은 셋이다:
#     (1) 판별은 **위치 무관**이다 — 파일 어디에 있어도 된다(고정 문자열 검색,
#         `grep -F`). 출처 주석을 위에 끼워 넣어도 판별은 안 깨진다 `[confirmed]`.
#     (2) 마커가 **없으면** 소비자 소유 훅으로 보고 손대지도 대조하지도 않는다.
#         그래서 이 줄을 지우면 드리프트 감시가 조용히 꺼진다 — 지우지 마라.
#     (3) 제품명을 넣지 않는다 — 개명 때 마커가 깨지면 대조가 조용히 멈춘다.
# opt-in git 훅: 자식 세션 워크트리에서 나가는 `git push` 차단
#
# ── 왜 git 훅인가 (하네스 중립 집행) ─────────────────────────────────────────
#
# 자식 세션의 push 차단은 이미 `hooks/examples/child-git-guard.py` 에 있다. 그것은
# **PreToolUse 훅**이라 Claude Code 하네스에서만 돈다. 실측: 다른 엔진(Codex)의
# 워커를 워크트리에 띄웠을 때 브리프에 적은 "push 금지" 는 산문일 뿐 **기계 강제가
# 0** 이었다. 워커는 지켰지만 그건 모델이 지시를 따른 것이지 무엇이 막은 게 아니다.
#
# git 훅으로 내리면 그 비대칭이 사라진다 — 누가 명령을 실행하든 똑같이 돈다
# (`reference-transaction` 이 같은 근거로 존재한다).
#
# ── 왜 한 번 깔면 모든 워커에 도달하는가 ─────────────────────────────────────
#
# 실측 `[confirmed]`:
#
#   git rev-parse --git-dir         → .git/worktrees/<name>   ← 워크트리 고유
#   git rev-parse --git-path hooks  → <주 저장소>/.git/hooks   ← 공유
#
# 연결된 워크트리는 `$GIT_COMMON_DIR/hooks` 를 **공유**한다. 주 저장소에 한 번 깔면
# 이후 생기는 모든 워커 워크트리에 자동 적용된다. 동시에 `--git-dir` 은 워크트리마다
# 다르므로 **공유 훅 하나가 워크트리별로 다르게 판정**한다. 공유 설치 + 국소 판정이
# 동시에 성립하는 것이 이 훅의 설계가 성립하는 이유다.
#
# ── 판정: 마커 하나, 그리고 그 마커는 다른 훅과 **같은 것**이어야 한다 ───────
#
# 자식 판별은 워크트리 로컬 마커 `$(git rev-parse --git-dir)/kit/child.json` 로 한다.
# `child-git-guard.py` 의 `MARKER_REL = ("kit", "child.json")` 과 **정확히 같은 경로·
# 같은 스키마**를 본다 — 두 훅이 다른 것을 보면 그 자체가 결함이다(한쪽은 막고 한쪽은
# 통과시키는 상태를 아무도 설명할 수 없다). 스키마 SSOT 는 `rules/child-marker.md`.
#
# 마커가 없으면 **통과**한다(fail-open). 자식 스킬을 로드하지 않은 세션은 보호 대상이
# 아니며, 없는 보호를 있다고 믿게 하지 않는다. 주 체크아웃(`--git-dir` == `--git-common-dir`)
# 은 마커가 있어도 자식이 아니다 — 마커는 자식임을 *확인*하는 것이지 부모가 쓰는 자리를
# 자식으로 *승격*하지 않는다.
#
# ── 이 훅이 보지 못하는 것 (정직한 한계) ─────────────────────────────────────
#
# git 훅은 **git 을 거치는 행위만** 본다. 파일 직접 수정·다른 워크트리 디렉토리 접근·
# 네트워크 API 호출은 이 훅의 사정거리 밖이고 여전히 산문 규약이다. 중립 집행의 범위는
# *"git 을 거치는 파괴적 행위"* 로 한정된다 — 그 밖을 막는다고 주장하지 않는다.
#
# **`--dry-run` 은 탐지할 수 없다.** git 은 pre-push 훅에 dry-run 여부를 주지 않는다.
# 실측 `[confirmed]`: `git push --dry-run` 과 실제 push 는 훅에 넘어오는 **argv·stdin·
# 환경변수가 전부 동일**했다(원격에는 아무것도 안 보내진 것이 remote log 로 확인됨).
# 구분할 신호가 없으므로 **dry-run 도 함께 막힌다.** 추정으로 통과시키지 않는다 —
# 탐지할 수 없는 것은 탐지할 수 없다고 적는다(`docs/conventions/warning-signal.md`).
# 과차단이지만 안전한 방향이다(dry-run 은 어차피 아무것도 보내지 않는다). 정말 필요하면
# 아래 탈출구를 쓴다.
#
# ── 설치 (opt-in) ───────────────────────────────────────────────────────────
#
#   H="$(git rev-parse --git-path hooks)"
#   cp "<플러그인 루트>/setup/git-hooks/pre-push" "$H/pre-push"
#   chmod +x "$H/pre-push"
#
# 해제는 그 파일을 지우면 된다. `--git-path` 를 쓰는 이유는 워크트리에서 `.git/hooks`
# 조립이 깨지기 때문이다(이 킷이 워크트리 운영을 권장한다).

set -u

# git 은 pre-push stdin 으로 `<local_ref> <local_sha> <remote_ref> <remote_sha>` 목록을
# 준다. 읽지 않고 종료하면 환경에 따라 SIGPIPE/EPIPE 가 난다 — 판정보다 먼저 비운다.
#
# **판정에는 쓰지 않는다.** 자식 세션의 규율은 "원격에 아무것도 보내지 않는다" 이지
# "어떤 ref 는 되고 어떤 ref 는 안 된다" 가 아니다. ref 별 분기(삭제 push·특정 브랜치
# 예외)를 두면 읽는 사람이 매번 그 표를 확인해야 하고, 예외 한 칸이 곧 구멍이 된다.
# 전부 막고 탈출구를 하나만 두는 쪽이 읽기 쉽고 설명 가능하다.
cat >/dev/null

_abs_dir() {
  # `--git-dir`·`--git-common-dir` 은 주 체크아웃에서 상대경로(`.git`), 워크트리에서
  # 절대경로를 준다 — 문자열 비교 전에 반드시 resolve 한다(child-git-guard 와 동일).
  (cd "$1" 2>/dev/null && pwd -P) || return 1
}

git_dir_raw="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
common_dir_raw="$(git rev-parse --git-common-dir 2>/dev/null)" || exit 0
[ -n "$git_dir_raw" ] && [ -n "$common_dir_raw" ] || exit 0

git_dir="$(_abs_dir "$git_dir_raw")" || exit 0
common_dir="$(_abs_dir "$common_dir_raw")" || exit 0

# 주 체크아웃은 자식이 아니다 — 부모(컨트롤) 세션이 push 하는 자리다.
[ "$git_dir" = "$common_dir" ] && exit 0

marker="$git_dir/kit/child.json"
[ -f "$marker" ] || exit 0   # 마커 없음 = 자식 스킬 미로드 = 보호 대상 아님(fail-open)

# 스키마 검증 — `rules/child-marker.md` 가 키 이름을 고정한다. 검증 없이 "파일이 있으면
# 자식" 으로 두면 쓰는 쪽이 키를 다르게 써도 통과한다(실측: 두 세션이 각각 `base_commit`·
# `baseline_commit` 을 썼다). 모르는 스키마 버전은 판정 불가 = 보호하지 않는다(fail-open).
#
# **JSON 은 JSON 파서로 판정한다.** 이전 구현은 `grep -E` 하나로 판정했는데, grep 은
# **줄 단위**라 `"schema": 1` 이 객체의 **마지막 키**이면(다음 줄이 `}`) 매치에 실패했다.
# 실패 방향이 `|| exit 0`, 즉 **push 허용** 이었으므로 판정이 **JSON 키 순서에 의존**했다.
# 훅이 자백한 한계는 *"키와 값이 서로 다른 줄"* 뿐이었는데, 이 경우는 **키와 값이 같은
# 줄인데도** 무너졌다 — 자백보다 넓은 구멍이었다.
# `hooks/examples/child-git-guard.py` 는 같은 판정을 파서로 정확히 하고 있었으므로,
# 두 훅이 같은 마커를 **다르게 판정**하는 상태가 실재했다(훅 자신의 주석이 그것을 결함이라
# 못 박았다). 이제 python3 가 있으면 그것으로 판정해 두 훅이 같은 답을 낸다.
_marker_is_child() {
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$1" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        data = json.load(fh)
except Exception:
    sys.exit(1)  # 손상된 마커는 없는 것과 동일하게 취급(fail-open)
if not isinstance(data, dict) or data.get("schema") != 1:
    sys.exit(1)  # 모르는 스키마 버전 = 판정 불가 = 보호하지 않는다(fail-open)
if not all(
    isinstance(data.get(k), str) and data[k]
    for k in ("parent", "role", "base_commit")
):
    sys.exit(1)
sys.exit(0)
PY
    return $?
  fi

  # python3 없음 — 정규식 폴백. 이것은 **구조 검사이지 파서가 아니다**: 키와 값이 서로
  # 다른 줄에 놓인(유효하지만 드문) 포맷은 인식하지 못하고 통과 방향으로 실패한다.
  # `([,}]|[[:space:]]*$)` 의 `$` 갈래가 위 결함을 막는다 — 값 뒤에 아무것도 없는
  # (= 마지막 키) 줄도 받는다.
  grep -Eq '"schema"[[:space:]]*:[[:space:]]*1[[:space:]]*([,}]|[[:space:]]*$)' "$1" || return 1
  for _key in parent role base_commit; do
    grep -Eq "\"$_key\"[[:space:]]*:[[:space:]]*\"[^\"]" "$1" || return 1
  done
  return 0
}

_marker_is_child "$marker" || exit 0

# 탈출구 — 정당한 push 가 필요한 자식이 있을 수 있다(북극성: 소비자 환경을 깨뜨리지
# 않는다). 막기만 하고 푸는 법을 안 알려주는 훅은 사람이 훅 자체를 지운다.
if [ "${KIT_ALLOW_CHILD_PUSH:-}" = "1" ]; then
  echo "[kit] KIT_ALLOW_CHILD_PUSH=1 — 자식 워크트리 push 차단을 이번 한 번 우회합니다." >&2
  exit 0
fi

echo "" >&2
echo "✗ 자식 세션 워크트리에서 나가는 'git push' 를 막았습니다 (hiway-kit git 훅)." >&2
echo "  이 워크트리에는 자식 세션 마커가 있습니다: \$(git rev-parse --git-dir)/kit/child.json" >&2
echo "  원격 반영(병합·push)은 부모(컨트롤) 세션의 몫입니다 — 워커는 자기 브랜치에" >&2
echo "  커밋만 하고 완료 보고로 넘깁니다." >&2
echo "" >&2
echo "  정말 필요하면 이번 명령에 한해:" >&2
echo "      KIT_ALLOW_CHILD_PUSH=1 git push ..." >&2
echo "  (export 하지 마십시오 — 그러면 차단이 세션 내내 꺼집니다.)" >&2
echo "" >&2
echo "  이 워크트리가 더 이상 자식이 아니라면 마커를 지우십시오:" >&2
echo "      rm \"\$(git rev-parse --git-dir)/kit/child.json\"" >&2
echo "  훅 자체를 끄려면:  rm \"\$(git rev-parse --git-path hooks)/pre-push\"" >&2
echo "" >&2
echo "  커밋은 그대로 남아 있습니다 — 아무것도 유실되지 않았습니다." >&2
exit 1

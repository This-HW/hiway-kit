#!/bin/bash
# kit-managed-hook
#   ↑ **드리프트 대조용 마커.** 계약은 셋이다:
#     (1) 판별은 **위치 무관**이다 — 파일 어디에 있어도 된다(고정 문자열 검색,
#         `grep -F`). 출처 주석을 위에 끼워 넣어도 판별은 안 깨진다 `[confirmed]`.
#     (2) 마커가 **없으면** 소비자 소유 훅으로 보고 손대지도 대조하지도 않는다.
#         그래서 이 줄을 지우면 드리프트 감시가 조용히 꺼진다 — 지우지 마라.
#     (3) 제품명을 넣지 않는다 — 개명 때 마커가 깨지면 대조가 조용히 멈춘다.
#
#   이 킷의 `verify-done.sh §21` 은 **레포 로컬 게이트라 배포되지 않는다.** 마커는
#   그 게이트 전용 장치가 아니라 **누구의 드리프트 가드든 쓸 수 있는 규약**이다.
#   훅을 자기 레포에 정본으로 들이는 경우, 대조 기준은 킷의 파일이 아니라 **자기
#   레포의 정본**이어야 한다 — 출처 주석 한 줄만 더해도 바이트가 갈리기 때문이다.
# opt-in git 훅: 태그 없는 `git stash` 차단
#
# ── 왜 git 훅인가 (하네스 중립 집행) ─────────────────────────────────────────
#
# 이 킷의 규율은 Claude Code 에서만 PreToolUse 훅으로 집행된다. Codex·Gemini·플레인
# 터미널에서는 같은 규율이 **지침으로만** 작동한다(rules/untrusted-text.md 가 이
# 비대칭을 명시한다). 집행을 하네스에서 git 으로 내리면 그 비대칭이 사라진다 —
# git 훅은 누가 명령을 실행하든 똑같이 돈다.
#
# `git stash` 는 커밋을 만들지 않으므로 pre-commit 이 볼 순간이 없고, git alias 는
# builtin 을 가로채지 못한다. 남는 수단이 `reference-transaction` 이다 — 모든 ref
# 갱신에 발화하므로 `refs/stash` 도 잡힌다(git 2.28+).
#
# ── 왜 태그 없는 stash 를 막는가 ─────────────────────────────────────────────
#
# stash 스택은 **저장소 전체가 공유**한다 — 모든 워크트리, 그리고 동시에 도는 다른
# 세션까지. 태그 없이 쌓으면 `git stash pop` 이 남의 항목을 꺼내고, 꺼낸 쪽은 그것이
# 남의 것인 줄 모른다. 태그를 강제하면 최소한 자기 것을 식별할 수 있다.
#
# ── 판정: 문구가 아니라 데이터로 한다 ────────────────────────────────────────
#
# bare `git stash` 는 제목을 자동 생성한다 — `WIP on <branch>: <HEAD 한 줄>`.
# `git stash push -m "tag"` 는 `On <branch>: tag` 다. "WIP on" 접두어로 판정하면
# **로케일 번역에 깨질 수 있고**, 그 취약성은 조용히 통과하는 방향이다(가드가 죽는다).
# 그래서 번역되지 않는 부분으로 판정한다: **제목이 HEAD 의 `%h %s` 로 끝나는가.**
# 그건 문구가 아니라 데이터라 어떤 로케일에서도 같다 `[confirmed]`.
#
# 경계: `-m "$(git log -1 --format='%h %s')"` 처럼 HEAD 한 줄을 그대로 태그로 쓰면
# 오탐이다. **차단 방향으로 실패**하므로 안전하다(통과시키는 오류가 아니다).
#
# ── 차단 시 작업은 보존된다 ──────────────────────────────────────────────────
#
# ref 갱신이 abort 되면 작업트리 리셋이 일어나지 않는다 — 수정·untracked 파일이 모두
# 그대로 남는다 `[confirmed]`. 이미 만들어진 stash 커밋이 dangling 으로 남지만 gc
# 대상이고, 오히려 복구 경로가 된다.
#
# ── 설치 ────────────────────────────────────────────────────────────────────
#
#   cp "<플러그인 루트>/setup/git-hooks/reference-transaction" \
#      "$(git rev-parse --git-path hooks)/reference-transaction"
#   chmod +x "$(git rev-parse --git-path hooks)/reference-transaction"
#
# 해제는 그 파일을 지우면 된다. `--git-path` 를 쓰는 이유는 워크트리에서 `.git/hooks`
# 조립이 깨지기 때문이다(이 킷이 워크트리 운영을 권장한다).

set -u

# prepared 단계에서만 거부할 수 있다. committed/aborted 는 통지일 뿐이다.
[ "${1:-}" = "prepared" ] || exit 0

ZERO="0000000000000000000000000000000000000000"
head_oneline="$(git log -1 --format='%h %s' 2>/dev/null || true)"
[ -n "$head_oneline" ] || exit 0   # 커밋이 없는 저장소 — 판정 불가, 통과(fail-open)

while read -r _old new ref; do
  [ "$ref" = "refs/stash" ] || continue
  [ "$new" = "$ZERO" ] && continue          # 삭제(pop/drop)는 이 훅의 대상이 아니다
  subject="$(git log -1 --format=%s "$new" 2>/dev/null || true)"
  [ -n "$subject" ] || continue
  case "$subject" in
    *"$head_oneline")
      echo "" >&2
      echo "✗ 태그 없는 'git stash' 를 막았습니다 (hiway-kit git 훅)." >&2
      echo "  stash 스택은 이 저장소의 모든 워크트리·동시 세션이 공유합니다 —" >&2
      echo "  태그가 없으면 나중에 누가 pop 할 때 남의 항목인지 알 수 없습니다." >&2
      echo "" >&2
      echo "  대신:  git stash push -u -m \"<식별 가능한 태그>\"" >&2
      echo "  더 나은 선택:  임시 WIP 커밋 (되돌리기 쉽고 공유 스택을 안 건드립니다)" >&2
      echo "" >&2
      echo "  작업 내용은 그대로 남아 있습니다 — 아무것도 유실되지 않았습니다." >&2
      exit 1
      ;;
  esac
done

exit 0

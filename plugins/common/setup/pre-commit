#!/bin/bash
# hiway-kit pre-commit hook
# kit-managed-hook
# 설치는 setup.sh 의 opt-in 경로뿐이다 (v5.0.0 부터 session-check 가 설치하지 않는다)

set -e

# 끄기 스위치 — 세션 훅과 같은 변수(HIWAY_KIT_DISABLE_HOOKS: 쉼표 목록 또는 all).
case ",$(printf '%s' "${HIWAY_KIT_DISABLE_HOOKS:-}" | tr '[:upper:]' '[:lower:]' | tr -d ' ')," in
    *,pre-commit,*|*,all,*) exit 0 ;;
esac

# 프로젝트가 ruff 를 쓰기로 했는가 — 파일에서 레포 루트까지 ruff.toml·.ruff.toml·[tool.ruff] 를 찾는다
# (hooks/utils.py has_ruff_config 와 같은 규칙). 설정 없는 레포를 고치면 손대지 않은 줄까지 바뀐다.
# 레포 상대 경로의 dirname 으로만 올라간다 — cd·심링크 해석이 없어 반드시 `.` 에서 끝나고 레포 밖
# 설정(~/ruff.toml 등)을 집지 않는다.
_REPO_ROOT="$(git rev-parse --show-toplevel)"
_has_ruff_config() {
    local dir
    dir="$(dirname "$1")"
    while :; do
        if [ -f "$_REPO_ROOT/$dir/ruff.toml" ] || [ -f "$_REPO_ROOT/$dir/.ruff.toml" ]; then return 0; fi
        if [ -f "$_REPO_ROOT/$dir/pyproject.toml" ] && grep -Eq '^[[:space:]]*\[tool\.ruff(\.[^]]*)?\][[:space:]]*(#.*)?$' "$_REPO_ROOT/$dir/pyproject.toml"; then
            return 0
        fi
        case "$dir" in .|/|"") return 1 ;; esac
        dir="$(dirname "$dir")"
    done
}

# Python 파일 ruff check
if command -v ruff &>/dev/null; then
    # macOS/Linux 호환: tr로 NUL→줄바꿈 변환 후 grep, 재NUL화
    STAGED_PY=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
    if [ -n "$STAGED_PY" ]; then
        while IFS= read -r f; do
            _has_ruff_config "$f" || continue
            # 일부만 스테이징한 파일은 고치지도 다시 스테이징하지도 않는다 — `git add` 가
            # 사용자가 일부러 빼 둔 수정까지 커밋에 넣는다.
            if ! git diff --quiet -- "$f"; then
                echo "⚠ $f: 스테이징하지 않은 변경이 있어 ruff --fix 를 건너뜀"
                continue
            fi
            before="$(md5 -q "$f" 2>/dev/null || md5sum "$f" 2>/dev/null | cut -d' ' -f1)"
            # --force-exclude 필수: 파일 경로를 **명시**하면 ruff는 프로젝트 설정의
            # exclude/extend-exclude를 무시한다. 그 결과 훅이 제외 대상(이 레포에선
            # evals/scenarios의 *의도적 결함 픽스처*)까지 린트하고, --fix가 붙어 있어
            # 그 결함을 자동 수정한 뒤 재스테이징할 수 있다 — eval 자산이 조용히 망가진다.
            # ruff.toml은 룰셋뿐 아니라 **범위**의 단일 소스이며(CLAUDE.md), 훅도 그 계약을 지킨다.
            ruff check --force-exclude --fix "$f" 2>/dev/null || true
            after="$(md5 -q "$f" 2>/dev/null || md5sum "$f" 2>/dev/null | cut -d' ' -f1)"
            if [ "$before" != "$after" ]; then
                git add "$f"
            fi
        done <<< "$STAGED_PY"
    fi
fi

# JSON 파일 유효성 검증
# 주석을 허용하는 JSONC 는 막지 않는다 — `tsc --init` 이 만든 tsconfig.json, VS Code 의 .vscode/*.json·
# devcontainer.json, 주석 단 .eslintrc.json·biome.json 등은 엄격한 JSON 파서로는 커밋이 막힌다.
# 두 겹이다: (1) JSONC 로 널리 쓰이는 이름은 검사하지 않는다(끝 쉼표만 있는 파일도 그 도구가 읽는다).
# (2) 그 밖의 파일은 엄격하게 읽고, 실패하면 주석이 **있는** 경우에만 주석·끝 쉼표를 걷어 다시 읽어 본다.
# 주석이 없는 끝 쉼표(`{"name": "x",}` 같은 깨진 package.json)는 계속 막는다.
# 함수 + stdin 프로그램으로 둔다 — `$( )` 안의 heredoc 은 macOS bash 3.2 가 괄호를 잘못 읽을 수 있다.
_jsonc_ok() {
    python3 - "$1" > /dev/null 2>&1 <<'PYEOF'
import json, re, sys
text = open(sys.argv[1], encoding="utf-8").read()
out, i, n, comments, in_str = [], 0, len(text), 0, False
while i < n:
    c = text[i]
    if in_str:
        out.append(c)
        if c == "\\":
            out.append(text[i + 1:i + 2])
            i += 2
            continue
        in_str = c != '"'
        i += 1
        continue
    if c == '"':
        in_str = True
    elif text.startswith("//", i):
        j = text.find("\n", i)
        i, comments = (n if j < 0 else j), comments + 1
        continue
    elif text.startswith("/*", i):
        j = text.find("*/", i + 2)
        if j < 0:
            sys.exit(1)
        i, comments = j + 2, comments + 1
        continue
    out.append(c)
    i += 1
if not comments:
    sys.exit(1)
json.loads(re.sub(r",(\s*[}\]])", r"\1", "".join(out)))
PYEOF
}
STAGED_JSON=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM | grep '\.json$' || true)
if [ -n "$STAGED_JSON" ]; then
    while IFS= read -r f; do
        case "/$f" in
            */tsconfig.json|*/tsconfig.*.json|*/tsconfig-*.json|*/jsconfig.json|*/jsconfig.*.json \
            | */.vscode/*.json|*/devcontainer.json|*/.devcontainer.json|*/.devcontainer/*.json) continue ;;
        esac
        if ! python3 -m json.tool "$f" > /dev/null 2>&1; then
            if _jsonc_ok "$f"; then
                echo "  · $f: 주석 있는 JSONC 로 보고 통과(엄격한 JSON 은 아님)"
                continue
            fi
            echo "❌ Invalid JSON: $f"
            exit 1
        fi
    done <<< "$STAGED_JSON"
fi

# 에이전트(plugins/*/agents/*.md) frontmatter 필수값 검증 — 비-에이전트 .md 는 대상이 아니다.
# 판정 정본은 scripts/check_agent_frontmatter.py(CI·verify-done §2). 이 훅은 scripts/ 가 없는
# 레포에도 설치되므로 인라인으로 둔다.
STAGED_MD=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM | grep -E '^plugins/[^/]+/agents/[^/]+\.md$' || true)
if [ -n "$STAGED_MD" ]; then
    python3 - <<'PYEOF'
import sys, re, pathlib, subprocess

result = subprocess.run(
    ["git", "-c", "core.quotePath=false", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
    capture_output=True, text=True
)
files = [f for f in result.stdout.splitlines() if re.match(r"^plugins/[^/]+/agents/[^/]+\.md$", f)]

errors = []
for fpath in files:
    p = pathlib.Path(fpath)
    if not p.exists():
        continue
    content = p.read_text(encoding="utf-8")
    m = re.match(r"^---\n(.*?)\n---", content, re.DOTALL)
    if not m:
        errors.append(f"{fpath}: frontmatter 없음 또는 닫히지 않음")
        continue
    fm = m.group(1)
    if "name:" not in fm:
        errors.append(f"{fpath}: frontmatter에 'name:' 필드 없음")
    if "description:" not in fm:
        errors.append(f"{fpath}: frontmatter에 'description:' 필드 없음")

if errors:
    for e in errors:
        print(f"❌ {e}")
    sys.exit(1)
PYEOF
fi

# 비공개 이름 차단 — 목록은 **커밋되지 않는 로컬 파일**에서 읽는다
#
# 왜 이 형태인가: 패턴(정규식)으로는 임의의 비공개 프로젝트 이름을 탐지할 수 없다.
# 이름을 알아야 잡히는데, 그 이름을 커밋되는 설정 파일(.gitleaks.toml 등)에 적으면
# **그 파일 자체가 유출**이 된다. 그래서 목록은 gitignore 된 로컬 파일에 두고 훅이
# 그것을 읽는다 — 보호는 동작하고 이름은 공개되지 않는다.
#
# 사용법: 레포 루트에 `.private-names` 를 만들고 한 줄에 하나씩 적는다(# 주석 허용).
# 파일이 없으면 이 검사는 조용히 통과한다(fail-open) — 없는 보호를 있다고 믿게 하지
# 않기 위해, 통과 사실을 아래에서 명시적으로 알린다.
# 실측 근거: 2026-09-08, 설계 문서 3곳에 비공개 프로젝트 이름이 들어갔는데 gitleaks 의
# 접미사 패턴 룰이 하나도 잡지 못했다(정밀도 4%, 재현율 0%).
NAMES_FILE="$(git rev-parse --show-toplevel)/.private-names"
if [ -f "$NAMES_FILE" ]; then
  STAGED="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM)"
  # 목록 파일 자체가 스테이징된 경우를 먼저 잡는다 — 이름이 그 안에 있는 것은 정상이므로
  # 아래 루프에 맡기면 "b.md 가 아니라 .private-names 가 걸렸다"는 혼란스러운 메시지가 난다.
  if printf '%s\n' "$STAGED" | grep -qx '\.private-names'; then
    printf '\033[31m✗ .private-names 자체가 스테이징됐습니다 — 이 파일은 커밋하면 안 됩니다.\033[0m\n'
    echo "  .gitignore 에 '.private-names' 를 넣고 'git restore --staged .private-names' 하세요."
    exit 1
  fi
  if [ -n "$STAGED" ]; then
    HITS=""
    while IFS= read -r name; do
      case "$name" in ''|'#'*) continue ;; esac
      # -F 고정 문자열, -I 바이너리 제외. 스테이징된 파일만 본다.
      #
      # `|| true` 가 필수다. 이 스크립트는 `set -e` 아래에서 돌고, **명령치환 대입의
      # 종료코드는 그 명령의 종료코드**다 — `grep -l` 은 매치가 없으면 1 을 내므로,
      # 위반이 하나도 없는 정상 커밋에서 훅이 그 줄에서 죽는다(실측으로 걸렸다).
      # "매치 없음" 은 정상 결과이지 실패가 아니다.
      found="$(printf '%s\n' "$STAGED" | tr '\n' '\0' \
        | xargs -0 grep -lFI -- "$name" 2>/dev/null || true)"
      # `[ ... ] && ...` 대신 `if` 를 쓰는 것도 같은 이유다 — 복합문이 비-0 이면 죽는다.
      if [ -n "$found" ]; then
        # **이름 자체는 찍지 않는다.** 이 훅의 출력은 터미널에만 남지 않는다 —
        # 에이전트 트랜스크립트·CI 로그·이슈 첨부로 옮겨 다니고, 그 순간 "목록을
        # 커밋하지 않는다"는 이 설계의 전제가 무너진다(실측: 되돌려-FAIL 검증 중
        # 훅 출력이 그대로 대화 로그에 실렸다). 소유자는 자기 목록을 이미 알고
        # 있으므로 첫 글자와 길이면 어느 항목인지 식별에 충분하다.
        masked="$(printf '%s' "$name" | cut -c1)…(${#name}자)"
        HITS="$HITS\n  $masked → $(printf '%s' "$found" | tr '\n' ' ')"
      fi
    done < "$NAMES_FILE"
    if [ -n "$HITS" ]; then
      printf '\033[31m✗ 비공개 이름이 스테이징된 파일에 있습니다:\033[0m'
      printf '%b\n' "$HITS"
      echo "  .private-names 목록의 항목입니다(이름은 일부러 가렸습니다 — 이 출력은"
      echo "  로그·트랜스크립트로 옮겨 다닙니다). 자리표시자로 바꾸고 다시 커밋하세요."
      exit 1
    fi
  fi
else
  echo "  · .private-names 없음 — 비공개 이름 검사 건너뜀 (보호 없음)"
fi

# 명시적으로 0 으로 닫는다 — 마지막 명령의 종료코드가 훅의 판정이 되지 않게.
# 이 배치에서 다룬 "종료코드를 읽지 않으면 게이트가 아니다"의 거울상이다: 여기서는
# 읽히지 않은 종료코드가 **거짓 차단**을 만든다.
exit 0
